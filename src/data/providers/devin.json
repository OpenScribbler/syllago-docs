{
  "id": "devin",
  "name": "Devin Desktop",
  "slug": "devin",
  "configDir": ".codeium/windsurf",
  "emitPath": "{project}/.windsurf/rules",
  "docsURL": "https://docs.windsurf.com",
  "category": "standalone-app",
  "content": {
    "agents": {
      "supported": true,
      "fileFormat": "md",
      "installMethod": "filesystem",
      "installPath": "{home}/.config/devin/agents",
      "symlinkSupport": false,
      "discoveryPaths": [
        "{project}/.devin/agents",
        "{project}/.agents/agents"
      ],
      "frontmatterFields": [
        "name",
        "description",
        "model",
        "allowed-tools",
        "tools",
        "max-nesting"
      ]
    },
    "commands": {
      "supported": true,
      "fileFormat": "md",
      "installMethod": "filesystem",
      "installPath": "{home}/.codeium/windsurf/global_workflows",
      "symlinkSupport": true,
      "discoveryPaths": [
        "{project}/.windsurf/workflows",
        "{home}/.codeium/windsurf/global_workflows"
      ]
    },
    "hooks": {
      "supported": true,
      "fileFormat": "json",
      "installMethod": "json-merge",
      "symlinkSupport": false,
      "hookEvents": [
        {
          "canonical": "after_compact",
          "nativeName": "PostCompaction",
          "category": "context"
        },
        {
          "canonical": "after_tool_execute",
          "nativeName": "PostToolUse",
          "category": "tool"
        },
        {
          "canonical": "agent_stop",
          "nativeName": "Stop",
          "category": "lifecycle"
        },
        {
          "canonical": "before_prompt",
          "nativeName": "UserPromptSubmit",
          "category": "lifecycle"
        },
        {
          "canonical": "before_tool_execute",
          "nativeName": "PreToolUse",
          "category": "tool"
        },
        {
          "canonical": "permission_request",
          "nativeName": "PermissionRequest",
          "category": "security"
        },
        {
          "canonical": "session_end",
          "nativeName": "SessionEnd",
          "category": "lifecycle"
        },
        {
          "canonical": "session_start",
          "nativeName": "SessionStart",
          "category": "lifecycle"
        }
      ],
      "hookTypes": [
        "command"
      ],
      "configLocation": ".devin/hooks.v1.json"
    },
    "loadouts": {
      "supported": false,
      "symlinkSupport": false
    },
    "mcp": {
      "supported": true,
      "fileFormat": "json",
      "installMethod": "json-merge",
      "symlinkSupport": false,
      "configLocation": ".windsurf/mcp_config.json",
      "mcpTransports": [
        "stdio",
        "sse"
      ]
    },
    "rules": {
      "supported": true,
      "fileFormat": "md",
      "installMethod": "filesystem",
      "installPath": "{home}/.codeium/windsurf",
      "symlinkSupport": true,
      "discoveryPaths": [
        "{project}/.windsurfrules",
        "{project}/.windsurf/rules"
      ],
      "frontmatterFields": [
        "trigger",
        "description",
        "globs"
      ]
    },
    "skills": {
      "supported": true,
      "fileFormat": "md",
      "installMethod": "filesystem",
      "installPath": "{home}/.config/devin/skills",
      "symlinkSupport": true,
      "discoveryPaths": [
        "{project}/.windsurf/skills",
        "{project}/.agents/skills"
      ],
      "frontmatterFields": [
        "name",
        "description"
      ]
    }
  }
}
